{
  "openapi": "3.0.3",
  "info": {
    "title": "Сервис учёта подписок",
    "version": "1.0.0",
    "description": "Фактические платежи заносятся вручную. Все суммы в RUB."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-requirements": {
    "F1": "Регистрация с уникальным email без учёта регистра. Ответы 201, 409 или 400.",
    "F2": "Вход выдаёт bearer-токен на 1 час. Закрытые методы требуют действительный токен. Logout отзывает его.",
    "F3": "Создание, список, получение, полное обновление и удаление своих подписок. Чужая запись даёт 404.",
    "F4": "Добавление фактического платежа для своей существующей подписки и история за период. Будущая дата запрещена.",
    "F5": "Отчёт за 1–366 дней включительно содержит сумму в RUB, число платежей и разбивку по категориям.",
    "N1": "Пароли защищены BCrypt, токены сохраняются как SHA-256, секреты не выводятся в диагностические журналы.",
    "N2": "Данные сохраняются в файловой H2 между перезапусками. Денежные вычисления используют DECIMAL и BigDecimal.",
    "N3": "Удаление подписки сохраняет историю платежей. Название и категория фиксируются на момент записи платежа.",
    "N4": "Java 17 и Maven. Бизнес-логика покрыта минимум на 80% ветвей и 90% строк и инструкций."
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Создать аккаунт",
        "responses": {
          "201": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Email уже занят",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Получить токен",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Login"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Требуется авторизация",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Отозвать токен",
        "responses": {
          "204": {
            "description": "Успешно"
          },
          "401": {
            "description": "Требуется авторизация",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/subscriptions": {
      "get": {
        "summary": "Список подписок",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Subscription"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Требуется авторизация",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Создать подписку",
        "responses": {
          "201": {
            "description": "Успешно",
